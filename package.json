{
  "name": "@solidstate/hardhat-storage-layout-inspector",
  "version": "1.0.2",
  "description": "Compare storage layouts between two contracts",
  "keywords": [
    "hardhat",
    "natspec",
    "buidler",
    "solidity",
    "solc",
    "smart-contracts",
    "ethereum",
    "blockchain",
    "wow"
  ],
  "repository": "github:solidstate-network/hardhat-storage-layout-inspector",
  "license": "MIT",
  "author": "Nick Barry",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "pnpm clean && tsc --build",
    "clean": "rm -rf dist/",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "prettier": "prettier --write .",
    "test": "pnpm clean && hardhat compile && tsx --test --experimental-test-coverage"
  },
  "dependencies": {
    "@solidstate/hardhat-git": "^1.0.0",
    "@solidstate/hardhat-solidstate-utils": "^1.0.0",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-utils": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.9.0",
    "exec-staged": "^0.1.3",
    "hardhat": "^3.0.7",
    "husky": "^9.1.7",
    "knip-exec-staged": "^5.63.1",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "prettier-plugin-solidity": "^2.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@nomicfoundation/hardhat-utils": "3.0.0",
    "hardhat": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
